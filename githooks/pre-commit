#!/bin/sh
# Contrôles i18n avant chaque commit. Deux, désormais.
#
# 1. check-i18n.mjs — parité des dictionnaires. Il attrape quatre choses que ni
#    `next build` ni ESLint ne voient, parce qu'elles ne cassent qu'à
#    l'exécution — ou pas du tout :
#      • une clé présente en fr/ et absente en en/ ou nl/ ;
#      • un marqueur {company} perdu à la traduction ;
#      • un composant qui appelle t() sans l'avoir déclaré (ReferenceError au
#        premier rendu, en général sur un écran candidat) ;
#      • une clé appelée qui n'existe dans aucun dictionnaire — la clé brute
#        s'affiche alors à l'écran, sans la moindre alerte.
#    Les trois derniers cas se sont réellement produits pendant la traduction.
#
# 2. check-langue-chat.mjs — langue de réponse des deux chats. Elle repose sur
#    des listes de mots, et une liste de mots, ça se complète : ajouter « je »
#    au français (c'est aussi du néerlandais) suffit à faire répondre de travers,
#    sans rien casser d'autre. Le bug ne se voit alors que chez un client.
#
# Pour passer outre ponctuellement : git commit --no-verify

# Sortie capturée puis filtrée, plutôt qu'un pipe : `$?` après un pipe renvoie
# le code de `grep`, pas celui de node, et le hook laisserait passer les
# erreurs. PIPESTATUS existe en bash mais pas dans le /bin/sh de tous les
# postes.
BRUIT="MODULE_TYPELESS_PACKAGE_JSON\|Reparsing as ES module\|To eliminate this warning\|trace-warnings"
code=0

for controle in scripts/check-i18n.mjs scripts/check-langue-chat.mjs; do
  sortie=$(node "$controle" 2>&1)
  if [ $? -ne 0 ]; then code=1; fi
  echo "$sortie" | grep -v "$BRUIT"
done

if [ "$code" -ne 0 ]; then
  echo ""
  echo "Commit interrompu par les contrôles i18n. Corrigez, ou --no-verify si c'est délibéré."
fi

exit "$code"
