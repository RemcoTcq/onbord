# Variables d'environnement attendues par Onbord.
#
# Copiez ce fichier en `.env.local` et renseignez les valeurs. Aucune valeur
# réelle ici : ce fichier est versionné, `.env*` ne l'est pas (cf. .gitignore).
#
# Règle de lecture : tout ce qui commence par NEXT_PUBLIC_ part dans le bundle
# NAVIGATEUR et est donc PUBLIC par construction. Tout le reste ne doit jamais
# apparaître dans un composant client.
#
# ── Séparation des environnements ────────────────────────────────────────────
# Un projet Supabase PAR environnement. Faire pointer un développement local sur
# le projet de production, c'est travailler sur de vraies données candidats — et
# c'était le cas au moment de l'audit du 19/08/2026 (§9). Les clés ci-dessous
# doivent différer entre dev, staging et production ; NEXT_PUBLIC_APP_URL aussi.


# ── Supabase ─────────────────────────────────────────────────────────────────
# Tableau de bord Supabase > Project Settings > API.

# URL du projet. Publique.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co

# Clé anon. Publique (elle est dans le bundle navigateur) : sa seule protection
# est la RLS. Toute table sans policy correcte est lisible par le monde entier.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role. SECRÈTE — elle contourne entièrement la RLS. Serveur
# uniquement (server actions, routes /api). Ne jamais la préfixer NEXT_PUBLIC_,
# ne jamais l'exposer à un composant client.
SUPABASE_SERVICE_ROLE_KEY=


# ── Anthropic ────────────────────────────────────────────────────────────────
# Génération d'expérience, scoring, assistant IA candidat. Facturée à l'usage :
# une clé qui fuite coûte de l'argent. console.anthropic.com
ANTHROPIC_API_KEY=


# ── Resend ───────────────────────────────────────────────────────────────────
# Envoi des e-mails aux candidats. resend.com/api-keys
RESEND_API_KEY=


# ── AssemblyAI ───────────────────────────────────────────────────────────────
# Transcription des réponses vidéo. Facturée à la minute.
ASSEMBLYAI_API_KEY=


# ── Application ──────────────────────────────────────────────────────────────
# Racine des liens envoyés aux candidats et de la redirection après
# confirmation d'e-mail. DOIT correspondre à l'environnement : un lien candidat
# pointant vers http://localhost:3000 en production est inutilisable.
#   dev        http://localhost:3000
#   production https://app.onbord.be
NEXT_PUBLIC_APP_URL=http://localhost:3000


# ── Administration ───────────────────────────────────────────────────────────
# Liste EXPLICITE des administrateurs, adresses séparées par des virgules.
# Variable absente ou vide = aucun administrateur : un oubli retire des accès,
# il n'en accorde pas. Volontairement non préfixée NEXT_PUBLIC_ — la liste des
# administrateurs n'a rien à faire dans un bundle client.
ADMIN_EMAILS=
